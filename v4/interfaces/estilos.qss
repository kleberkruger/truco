/* ======================================================================
   Truco Paulista — Estilos QSS (Qt Style Sheets)
   Todos os estilos visuais estão centralizados aqui.
   ====================================================================== */

/* ------------------------------------------------------------------
   Tema global — janela e widgets base
   ------------------------------------------------------------------ */

QMainWindow {
    background-color: #05070a;
}
QFrame, QWidget {
    border: none;
    outline: none;
}
QFrame.arena-canvas {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.75, fx:0.5, fy:0.5,
        stop:0 #0c3327, stop:0.65 #061e17, stop:1 #020b08);
    border-radius: 36px;
}
QFrame#hud-side-container {
    background-color: rgba(15, 20, 32, 0.85);
    border-radius: 24px;
}
QLabel {
    color: #f1f5f9;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border: none;
}
QPushButton {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border: none;
    outline: none;
}
QPushButton#btn-gold {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fbbf24, stop:1 #d97706);
    color: #000;
    font-weight: 800;
    font-size: 15px;
    border-radius: 16px;
    padding: 14px 24px;
}
QPushButton#btn-gold:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fcd34d, stop:1 #fbbf24);
}
QPushButton#btn-gold:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d97706, stop:1 #b45309);
}
QPushButton#btn-gold:disabled {
    background-color: #1e2433;
    color: #475569;
}
QPushButton#btn-dark {
    background-color: rgba(30, 41, 59, 0.8);
    color: #f8fafc;
    font-weight: 700;
    font-size: 13px;
    border-radius: 12px;
    padding: 10px 18px;
}
QPushButton#btn-dark:hover {
    background-color: rgba(51, 65, 85, 0.95);
}
QPushButton#btn-dark:pressed {
    background-color: rgba(71, 85, 105, 0.95);
}
QListWidget#hud-ticker {
    background-color: rgba(15, 20, 32, 0.7);
    border-radius: 20px;
    color: #94a3b8;
    padding: 12px;
    font-size: 12px;
}
QListWidget#hud-ticker::item {
    padding: 6px 8px;
}
QScrollBar:vertical {
    border: none;
    background: rgba(15, 23, 42, 0.2);
    width: 5px;
    margin: 4px 2px 4px 2px;
    border-radius: 2px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.2);
    min-height: 24px;
    border-radius: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #fbbf24;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ------------------------------------------------------------------
   Menu principal
   ------------------------------------------------------------------ */

QLabel#lbl_logo {
    background-color: transparent;
    color: #fbbf24;
    font-size: 32px;
    font-weight: 900;
    letter-spacing: 2px;
}

QLabel#lbl_sub {
    background-color: transparent;
    color: #64748b;
    font-size: 14px;
    margin-bottom: 24px;
}

QLabel#lbl_mod,
QLabel#lbl_bar,
QLabel#lbl_diff {
    background-color: transparent;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 800;
}

QPushButton#btn_start {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fbbf24, stop:1 #d97706);
    color: #000;
    font-weight: 800;
    font-size: 15px;
    border-radius: 16px;
    padding: 14px 24px;
}

/* ------------------------------------------------------------------
   Placar lateral — HUD
   ------------------------------------------------------------------ */

QLabel#lbl_pontuacao_geral {
    background-color: transparent;
    color: #fbbf24;
    font-size: 11px;
    font-weight: 800;
}

QLabel#lbl_e0,
QLabel#lbl_e1 {
    background-color: transparent;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
}

QLabel#lbl_score_eq0 {
    background-color: transparent;
    color: #fbbf24;
    font-size: 36px;
    font-weight: 900;
}

QLabel#lbl_score_eq1 {
    background-color: transparent;
    color: #f8fafc;
    font-size: 36px;
    font-weight: 900;
}

QLabel#lbl_div {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.3);
    font-size: 20px;
    font-weight: 800;
}

QFrame#separator {
    background-color: rgba(255, 255, 255, 0.08);
    max-height: 1px;
}

/* Placar da mão */

QLabel#lbl_mao_info {
    background-color: transparent;
    color: #fbbf24;
    font-size: 14px;
    font-weight: 900;
}

QLabel#lbl_vazas_label {
    background-color: transparent;
    color: #64748b;
    font-size: 9px;
    font-weight: 700;
}

QLabel#lbl_vazas_eq0 {
    background-color: transparent;
    color: #fbbf24;
    font-size: 16px;
    font-weight: 900;
}

QLabel#lbl_vazas_eq1 {
    background-color: transparent;
    color: #f8fafc;
    font-size: 16px;
    font-weight: 900;
}

QLabel#lbl_vazas_dash {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.2);
    font-size: 12px;
}

QLabel#vazas_sep1,
QLabel#vazas_sep2 {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.1);
    font-size: 10px;
}

/* ------------------------------------------------------------------
   Log de acontecimentos
   ------------------------------------------------------------------ */

QLabel#lbl_log_title {
    color: #fbbf24;
    font-size: 11px;
    font-weight: 800;
    padding-left: 4px;
}

/* ------------------------------------------------------------------
   Mesa — Vira
   ------------------------------------------------------------------ */

QLabel#lbl_v {
    color: #64748b;
    font-size: 11px;
    font-weight: 800;
}

/* ------------------------------------------------------------------
   Diálogos modais
   ------------------------------------------------------------------ */

QFrame#panel {
    background-color: #0f1420;
    border-radius: 24px;
}

QLabel#lbl_title {
    color: #fbbf24;
    font-size: 22px;
    font-weight: 800;
}

QLabel#lbl_msg {
    color: #94a3b8;
    font-size: 14px;
}

QPushButton#btn-destaque {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fbbf24, stop:1 #f59e0b);
    color: #000;
    font-weight: 800;
    border-radius: 12px;
}

QPushButton#btn-secundario {
    background-color: #1e293b;
    color: #f8fafc;
    font-weight: 700;
    border-radius: 12px;
}

/* ------------------------------------------------------------------
   Diálogo mão encerrada — caixas de score
   ------------------------------------------------------------------ */

QFrame#score-box {
    background-color: #1e293b;
    border-radius: 14px;
}

QLabel#score-nome {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 800;
}

QLabel#score-valor-0 {
    color: #fbbf24;
    font-size: 34px;
    font-weight: 900;
}

QLabel#score-valor-1 {
    color: #f8fafc;
    font-size: 34px;
    font-weight: 900;
}

/* ------------------------------------------------------------------
   Cartas jogadas na mesa
   ------------------------------------------------------------------ */

QLabel#lbl_carta-maior {
    color: #fbbf24;
    font-size: 11px;
    font-weight: 800;
}

QLabel#lbl_carta-menor {
    color: #94a3b8;
    font-size: 11px;
}

/* ------------------------------------------------------------------
   Avatares dos bots
   ------------------------------------------------------------------ */

QLabel#avatar-vez {
    background-color: #fbbf24;
    color: #000;
    font-weight: 900;
    border-radius: 19px;
}

QLabel#avatar-parceiro {
    background-color: #10b981;
    color: #000;
    font-weight: 900;
    border-radius: 19px;
}

QLabel#avatar-adversario {
    background-color: #1e293b;
    color: #000;
    font-weight: 900;
    border-radius: 19px;
}

QLabel#nome-parceiro {
    color: #fbbf24;
    font-size: 10px;
    font-weight: 800;
}

QLabel#nome-adversario {
    color: #94a3b8;
    font-size: 10px;
}

/* ------------------------------------------------------------------
   Menu principal — painel
   ------------------------------------------------------------------ */

QFrame#menu-panel {
    background-color: rgba(15, 20, 32, 0.85);
    border-radius: 28px;
}

/* ------------------------------------------------------------------
   Menu principal — botões de seleção (estado dinâmico)
   ------------------------------------------------------------------ */

QPushButton#menu-btn-selected {
    background-color: #fbbf24;
    color: #000;
    font-weight: 800;
    border-radius: 10px;
    padding: 10px;
}

QPushButton#menu-btn-unselected {
    background-color: transparent;
    color: #94a3b8;
    border-radius: 10px;
    padding: 10px;
}
